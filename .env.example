# =========================================================
# TRACIA Platform Environment & Backend Configuration
# =========================================================

# Authentication JWT Secret (Keep identical across cluster nodes)
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Core FastAPI / Microservices Backend URL
FASTAPI_BACKEND_URL=http://localhost:8000

# Neo4j Graph Database Connection (Bolt Protocol)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# AI Copilot & GraphRAG Service URL
GRAPHRAG_LLM_URL=http://localhost:8000/api/graphrag

# Permissioned Blockchain RPC Node / Service URL
BLOCKCHAIN_RPC_URL=http://localhost:8545

# Database Path for SQLite operational fallback
SQLITE_DB_PATH=./data/tracia.db
